DATABASE_URL=postgres://reelcanon:reelcanon@localhost:5432/reelcanon?sslmode=disable
# Optional production roles; use a read-only role for the public API.
API_DATABASE_URL=
ADMIN_DATABASE_URL=
API_ADDR=:8080
ADMIN_ADDR=:8081
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-before-use
TMDB_API_KEY=
TMDB_READ_ACCESS_TOKEN=
# Optional: serve the built SPA from the public API (relative to backend/).
FRONTEND_DIST=
VITE_API_BASE_URL=/api/v1
# Public Ko-fi creator page. Leave empty to hide the support link.
VITE_SUPPORT_URL=https://ko-fi.com/milkproduction

# Account development (no external mail provider needed).
# Keep catalog access read-only; grant USER_DATABASE_URL writes only to account tables.
AUTH_ENABLED=false
USER_DATABASE_URL=
AUTH_PUBLIC_URL=http://127.0.0.1:5173
AUTH_ALLOWED_ORIGINS=http://127.0.0.1:8080
AUTH_MAIL_MODE=file
# Relative to backend/ for make api and make dev-mail:
AUTH_MAIL_DIR=../.local/mail
# Google is hidden until both credentials are configured.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 random bytes in standard base64; required only when Google is enabled.
AUTH_STATE_KEY=

# Explicit Google mobile authorized-party client IDs (public IDs only).
# Empty disables mobile Google login; verify Android package/signature in Cloud first.
GOOGLE_MOBILE_CLIENT_IDS=
