{
  "name": "@reelcanon/public-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "lint": "tsc -b --pretty false",
    "test": "vitest run",
    "test:e2e": "node ../scripts/run-e2e.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"e2e/**/*.ts\" \"*.{json,ts}\" \"../localization/*.json\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"e2e/**/*.ts\" \"*.{json,ts}\" \"../localization/*.json\"",
    "clean": "node scripts/clean.mjs",
    "i18n:check": "node ../scripts/localization.mjs",
    "i18n:generate": "node ../scripts/localization.mjs --write",
    "prebuild": "npm run i18n:check",
    "prelint": "npm run i18n:check"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.2",
    "dexie": "^4.2.1",
    "i18next": "^26.4.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-i18next": "^17.0.15",
    "react-router-dom": "^7.9.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^7.1.9",
    "vitest": "^5.0.3"
  }
}
